  "sentences": [
    {"text": "Dense, velvet darkness enveloped the house.", "vibe": "General"},
    {"text": "A vast, glittering canopy of stars arched overhead, so bright that the hills cast shadows.", "vibe": "Beautiful"},
    {"text": "Pale, silvery moonlight bathed the garden and turned the lawn to pewter.", "vibe": "Beautiful"},
    {"text": "A thin, crescent moon hung above the rooftops like a paring of fingernail.", "vibe": "Beautiful"},
    {"text": "The starless, moonless night swallowed the path a few steps ahead of her.", "vibe": "Menacing"},
    {"text": "Black, shifting shadows crept along the wall.", "vibe": "Menacing"},
    {"text": "A deep, unbroken silence settled over the sleeping town.", "vibe": "Peaceful"},
    {"text": "An eerie, spectral glow flickered between the trees and was gone.", "vibe": "Menacing"},
    {"text": "Ragged, drifting clouds veiled the moon, and the fields went dark as if a lamp had been turned down.", "vibe": "General"},
    {"text": "A solitary owl hooted from the churchyard.", "vibe": "Menacing"},
    {"text": "The feeble, yellow beam of his torch probed the darkness and found nothing.", "vibe": "General"},
    {"text": "The cold, small hours dragged towards dawn.", "vibe": "Lonely"},
    {"text": "A dim, distant street lamp cast a lonely pool of light on the wet road.", "vibe": "Lonely"},
    {"text": "It was a clear, frosty night, and the stars twinkled like chips of ice.", "vibe": "Peaceful"},
    {"text": "Tall, sinister silhouettes reared against the sky where the pines began.", "vibe": "Menacing"},
    {"text": "In the tropics, night fell without warning, like a curtain.", "vibe": "General"},
    {"text": "The fairground blazed against the dark, all music and whirling lights.", "vibe": "Lively"},
    {"text": "Fireworks burst over the river, and the crowd roared at each one.", "vibe": "Lively"},
    {"text": "The wind tore the clouds across the moon, and the trees roared like surf.", "vibe": "Wild"},
    {"text": "Something large crashed through the undergrowth, and every dog in the valley began to bark.", "vibe": "Wild"},
    {"text": "At three in the morning, the whole world seemed to belong to somebody else.", "vibe": "Lonely"},
    {"text": "One lit window, far across the fields, was the only sign that anyone else was awake.", "vibe": "Lonely"},
    {"text": "Something prowled at the edge of the firelight, patient and unseen.", "vibe": "Menacing"},
    {"text": "The darkness rustled.", "vibe": "Menacing"},
    {"text": "Frost silvered the grass, and every blade glimmered under the moon.", "vibe": "Beautiful"},
    {"text": "The moon laid a path of soft radiance across the bay.", "vibe": "Beautiful"},
    {"text": "The village slept, and the only sound was the river talking to itself.", "vibe": "Peaceful"},
    {"text": "She lay on the cool grass and counted constellations until her eyes closed.", "vibe": "Peaceful"},
    {"text": "Midnight struck, twelve slow notes dropping into the dark.", "vibe": "General"},
    {"text": "His eyes adjusted slowly, and shapes began to separate from the blackness.", "vibe": "General"}
  ]
