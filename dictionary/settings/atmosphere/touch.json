  "sentences": [
    {"text": "Soft, velvety petals brushed against her cheek as she bent to the rose.", "vibe": "Peaceful"},
    {"text": "The rough, gnarled bark scraped his palms as he climbed.", "vibe": "General"},
    {"text": "A cold, clammy hand closed around her wrist.", "vibe": "Menacing"},
    {"text": "Slimy, slippery weed clung to his ankles and would not let go.", "vibe": "Menacing"},
    {"text": "The coarse, scratchy blanket prickled against her skin all night.", "vibe": "General"},
    {"text": "The smooth, cool silk slid through her fingers like water.", "vibe": "Beautiful"},
    {"text": "A sharp, jagged edge grazed his knuckles.", "vibe": "Menacing"},
    {"text": "The cat's warm, silky fur rippled under her hand.", "vibe": "Peaceful"},
    {"text": "The icy, numbing water stung like needles.", "vibe": "General"},
    {"text": "Damp, spongy moss yielded beneath her feet.", "vibe": "General"},
    {"text": "With one finger he traced the carved letters in the worn, smooth stone.", "vibe": "General"},
    {"text": "Fine, gritty sand trickled between her toes.", "vibe": "General"},
    {"text": "His fingers tingled with cold as the feeling came back.", "vibe": "General"},
    {"text": "She recoiled from the touch of that dry, leathery skin.", "vibe": "Menacing"},
    {"text": "His bristly, unshaven chin rasped against his collar.", "vibe": "Lonely"},
    {"text": "She squeezed his hand gently and said nothing.", "vibe": "Peaceful"},
    {"text": "A faint prickle of goosebumps crept up her arms.", "vibe": "Menacing"},
    {"text": "The hot, blistering metal burned his fingertips before he could let go.", "vibe": "Wild"},
    {"text": "Sand whipped against their bare legs like a thousand tiny stings.", "vibe": "Wild"},
    {"text": "He gripped the rope until it tore the skin from his palms.", "vibe": "Wild"},
    {"text": "The other side of the bed was cold to the touch.", "vibe": "Lonely"},
