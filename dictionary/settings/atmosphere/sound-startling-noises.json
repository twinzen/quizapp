  "sentences": [
    {"text": "A sudden, ear-splitting crash shattered the silence.", "vibe": "Menacing"},
    {"text": "A piercing, blood-curdling scream rang out across the courtyard.", "vibe": "Menacing"},
    {"text": "A deafening, thunderous roar erupted from the crowd as the ball hit the net.", "vibe": "Lively"},
    {"text": "A sharp, explosive crack echoed around the valley.", "vibe": "General"},
    {"text": "A shrill, insistent alarm jolted him awake.", "vibe": "Menacing"},
    {"text": "A heavy, resounding thud shook the floorboards.", "vibe": "General"},
    {"text": "A harsh, metallic clang reverberated through the building.", "vibe": "Menacing"},
    {"text": "A violent gust of wind caught the door, which slammed against the wall.", "vibe": "Wild"},
    {"text": "A hoarse, guttural bellow burst from his throat.", "vibe": "Menacing"},
    {"text": "A long, unearthly howl rose from the woods.", "vibe": "Menacing"},
    {"text": "The sudden, sickening screech of brakes tore through the quiet street.", "vibe": "General"},
    {"text": "A raucous, jarring din spilled from the playground.", "vibe": "Lively"},
    {"text": "The tray slipped from her hands and clattered to the floor.", "vibe": "General"},
    {"text": "The bang of the firework made her jump.", "vibe": "General"},
    {"text": "A thin, frantic wail pierced the darkness.", "vibe": "Menacing"},
    {"text": "The waves boomed like cannon fire against the foot of the cliff.", "vibe": "Wild"},
    {"text": "The jug slid off the edge and smashed on the tiles.", "vibe": "General"},
    {"text": "She froze at the sound: three slow knocks on the cellar door.", "vibe": "Menacing"},
    {"text": "The window exploded inwards, and glass sprayed across the room.", "vibe": "Wild"},
    {"text": "Thunder crashed directly overhead, and every light in the house went out.", "vibe": "Wild"},
    {"text": "Somewhere in the fog, a woman screamed.", "vibe": "Menacing"},
    {"text": "The telephone shrieked in the empty hall.", "vibe": "Menacing"},
    {"text": "Car horns blared, drums pounded, and the whole street joined the uproar.", "vibe": "Lively"},
    {"text": "The classroom erupted the moment the teacher left the room.", "vibe": "Lively"},
    {"text": "He flinched at the slam of the gate.", "vibe": "General"},
    {"text": "The gunshot echoed twice before the silence closed over it.", "vibe": "General"},
    {"text": "The clatter of the dropped spoon was shockingly loud in the silent kitchen.", "vibe": "Lonely"},
    {"text": "A single bang, far off, and then nothing; no one else seemed to have heard it.", "vibe": "Lonely"},
    {"text": "The blast threw them to the ground, and for a moment there was no sound at all.", "vibe": "Menacing"},
    {"text": "With a boom and a roar, the ice on the river broke.", "vibe": "Wild"}
