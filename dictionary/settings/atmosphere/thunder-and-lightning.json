  "sentences": [
    {"text": "A low, ominous rumble rolled across the valley.", "vibe": "Menacing"},
    {"text": "Towering, black thunderheads massed on the horizon.", "vibe": "Menacing"},
    {"text": "A jagged, white fork of lightning split the sky from top to bottom.", "vibe": "Wild"},
    {"text": "A sudden, deafening thunderclap shook the house to its foundations.", "vibe": "Wild"},
    {"text": "A brief, brilliant flash lit the room like day, and for an instant every object had a shadow.", "vibe": "Beautiful"},
    {"text": "A long, rolling peal reverberated around the hills.", "vibe": "Wild"},
    {"text": "Distant, grumbling thunder growled in the west.", "vibe": "General"},
    {"text": "The heavy, charged air crackled with electricity, and the hair rose on her arms.", "vibe": "Menacing"},
    {"text": "A blinding, white-hot bolt struck the old oak and split it to the root.", "vibe": "Wild"},
    {"text": "Pale, silent sheet lightning flickered behind the clouds.", "vibe": "Beautiful"},
    {"text": "An eerie, lurid light bathed the garden, turning the grass a sickly green.", "vibe": "Menacing"},
    {"text": "Each crash rattled the windows.", "vibe": "General"},
    {"text": "A tense, breathless hush fell before the storm; even the birds stopped singing.", "vibe": "Lonely"},
    {"text": "Lightning tore across the sky in three places at once.", "vibe": "Wild"},
    {"text": "The next clap exploded directly overhead.", "vibe": "Wild"},
    {"text": "She counted the seconds between the flash and the bang: the storm was two miles off.", "vibe": "General"},
    {"text": "At last the faint, fading rumbles rolled away to the east.", "vibe": "Peaceful"},
    {"text": "Under a dark, bruised sky, the first drops fell as large as coins.", "vibe": "Menacing"},
    {"text": "The children squealed at every flash, half terrified and half delighted.", "vibe": "Lively"},
    {"text": "The dog dived under the table and refused to come out.", "vibe": "Lively"},
    {"text": "Thunder crashed and boomed like furniture being dragged across the floor of heaven.", "vibe": "Wild"},
    {"text": "Hail followed the lightning, rattling on the roof like thrown gravel.", "vibe": "Wild"},
    {"text": "Alone in the house, he waited for each flash and dreaded each silence.", "vibe": "Lonely"},
    {"text": "The storm passed over the empty farm with no one to hear it.", "vibe": "Lonely"},
    {"text": "The glare showed, for half a second, a figure standing at the gate.", "vibe": "Menacing"},
    {"text": "The whole sky was illuminated, and the clouds stood out like mountains of white marble.", "vibe": "Beautiful"},
    {"text": "Afterwards the air was cool and clean, and water dripped quietly from every leaf.", "vibe": "Peaceful"},
    {"text": "The downpour began with the third crack of thunder.", "vibe": "General"},
    {"text": "An echo of the last peal came back from the far side of the lake.", "vibe": "General"},
    {"text": "The storm broke with a violent flash and a noise like the sky tearing.", "vibe": "Wild"}
  ]
}
