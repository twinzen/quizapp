  "sentences": [
    {"text": "The stately, old mansion stood at the end of the lane, aloof behind its iron gates.", "vibe": "Beautiful"},
    {"text": "The crumbling, ruined castle loomed against the sky like a broken crown.", "vibe": "Menacing"},
    {"text": "A sleek, glass skyscraper soared above the city and threw back the sun.", "vibe": "Beautiful"},
    {"text": "The ancient, timbered hall perched on the hilltop, visible for miles.", "vibe": "General"},
    {"text": "The crooked, brick chimney leaned at a perilous angle, waiting for one more winter.", "vibe": "Menacing"},
    {"text": "The abandoned, derelict factory decayed a little more each winter.", "vibe": "Lonely"},
    {"text": "The cosy, thatched cottage overlooked the harbour.", "vibe": "Peaceful"},
    {"text": "The vast, white palace gleamed in the sunshine like an iced cake.", "vibe": "Beautiful"},
    {"text": "Lamps glowed in every window, and a lantern hung in the warm, welcoming porch.", "vibe": "Peaceful"},
    {"text": "Broken, rotting shutters banged in the wind.", "vibe": "Menacing"},
    {"text": "The whole house creaked and groaned as the storm tightened its grip.", "vibe": "Wild"},
    {"text": "Paint peeled from the walls of the tiny, cramped flat.", "vibe": "General"},
    {"text": "Ivy crept up the walls of the gloomy, grey house and blinded half its windows.", "vibe": "Menacing"},
    {"text": "The church tower, with its grotesque, stone gargoyles, cast a long shadow across the graveyard.", "vibe": "Menacing"},
    {"text": "Dark, vacant windows stared down at them like eyes.", "vibe": "Menacing"},
    {"text": "The grey, concrete block of flats dwarfed the houses around it.", "vibe": "General"},
    {"text": "The roof of the huge, ramshackle barn sagged in the middle like the back of an old horse.", "vibe": "Lonely"},
    {"text": "Wide, stone steps led up to the front door, between tall, marble pillars.", "vibe": "Beautiful"},
    {"text": "The windows rattled in their frames each time a train went by.", "vibe": "General"},
    {"text": "Smoke curled from the chimney above the steep, slate roof.", "vibe": "General"},
    {"text": "The factory rose above the town, and rows of small houses huddled in its shadow.", "vibe": "General"},
    {"text": "Thick, stone walls kept the house cool in summer and warm in winter.", "vibe": "General"},
    {"text": "Slender, pointed turrets rose from each corner of the castle.", "vibe": "Beautiful"},
    {"text": "The shabby, boarded-up warehouse had been empty for as long as anyone could remember.", "vibe": "Lonely"},
    {"text": "The gale tore tiles from the roof and hurled them into the street.", "vibe": "Wild"},
    {"text": "Lightning lit the tower, and thunder shook the building to its foundations.", "vibe": "Wild"},
    {"text": "The building was alive with noise: doors slammed, phones rang and feet clattered on the stairs.", "vibe": "Lively"},
    {"text": "Builders shouted and hammered on the scaffolding from dawn until dusk.", "vibe": "Lively"},
    {"text": "It was a small, friendly house with a red door and flowers on every windowsill.", "vibe": "Peaceful"},
    {"text": "No one had lived there for fifty years, and the garden had swallowed the path to the door.", "vibe": "Lonely"}
