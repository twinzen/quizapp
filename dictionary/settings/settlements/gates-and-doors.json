  "sentences": [
    {"text": "The heavy, oak door swung open without a sound.", "vibe": "General"},
    {"text": "The tall, wrought-iron gates slammed shut behind them with a finality that needed no explanation.", "vibe": "Menacing"},
    {"text": "The massive, iron-studded door groaned open, and a cold draught swept out to meet them.", "vibe": "Menacing"},
    {"text": "The rickety garden gate clicked shut behind the postman.", "vibe": "General"},
    {"text": "The wind caught the gate, which clanged against the wall again and again.", "vibe": "Wild"},
    {"text": "The letterbox rattled in the wind like chattering teeth.", "vibe": "General"},
    {"text": "The battered, splintered door hung from a single hinge.", "vibe": "Lonely"},
    {"text": "In the middle of the night, someone hammered on the door with both fists.", "vibe": "Menacing"},
    {"text": "She lifted the polished brass knocker and rapped three times.", "vibe": "General"},
    {"text": "The large, iron key grated in the lock, unwilling after so many years.", "vibe": "General"},
    {"text": "The stiff, heavy bolt slid back with a thud.", "vibe": "General"},
    {"text": "He gripped the handle with both hands and heaved it open.", "vibe": "General"},
    {"text": "A thick, rusty chain barred the entrance.", "vibe": "Menacing"},
    {"text": "A low, arched doorway led into the courtyard.", "vibe": "General"},
    {"text": "Suddenly the door burst open, and the wind put out every candle.", "vibe": "Wild"},
    {"text": "The gate had jammed fast on its ancient, rusted hinges.", "vibe": "General"},
    {"text": "He knelt and peered through the keyhole into darkness.", "vibe": "General"},
    {"text": "The cellar door stood ajar, showing a narrow blade of light.", "vibe": "Menacing"},
    {"text": "Two stone lions guarded the entrance, one on either side of the dark, forbidding gateway.", "vibe": "Menacing"},
    {"text": "The kitchen door opened onto the garden, and sunshine poured in.", "vibe": "Peaceful"},
    {"text": "She pushed and pulled, but the hatch refused to budge.", "vibe": "General"},
    {"text": "The little gate squealed on its hinges whenever anyone came up the path.", "vibe": "General"},
    {"text": "The brightly painted front door wore a wreath of fresh flowers.", "vibe": "Peaceful"},
    {"text": "Faded, peeling paint curled from the door of the empty house like dead skin.", "vibe": "Lonely"},
    {"text": "Sharp, iron spikes ran along the top of the wall.", "vibe": "Menacing"},
    {"text": "Ornate, carved panels covered the door from lintel to threshold.", "vibe": "Beautiful"},
    {"text": "The gleaming, gilded gates of the palace blazed in the sun.", "vibe": "Beautiful"},
    {"text": "Behind the curtain was a small, concealed door, no higher than her waist.", "vibe": "General"},
    {"text": "Generations of feet had hollowed the worn, stone threshold.", "vibe": "General"},
    {"text": "Doors banged, bells rang and visitors streamed in and out all day long.", "vibe": "Lively"}
  ]
