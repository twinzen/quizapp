  "sentences": [
    {"text": "The tiny, tranquil village nestled among the hills, a full hour from the nearest town.", "vibe": "Peaceful"},
    {"text": "Honey-coloured, thatched cottages clustered around the green, behind immaculate, flower-filled gardens.", "vibe": "Beautiful"},
    {"text": "The quiet village green drowsed in the afternoon sun.", "vibe": "Peaceful"},
    {"text": "A narrow, muddy lane wound between the hedgerows to the farm.", "vibe": "General"},
    {"text": "Every Sunday the bells of the squat, stone church pealed across the fields.", "vibe": "General"},
    {"text": "Thin, blue wood smoke curled from the chimneys and hung in the still air.", "vibe": "Peaceful"},
    {"text": "A cockerel crowed from the farmyard long before anyone else was stirring.", "vibe": "Lively"},
    {"text": "Sheep grazed in the meadow beyond the low, dry-stone walls.", "vibe": "Peaceful"},
    {"text": "A procession of ducks waddled across the road from the round, reedy duck pond.", "vibe": "Lively"},
    {"text": "A rusting, old tractor trundled down the lane, shedding clods of mud.", "vibe": "General"},
    {"text": "Friendly, gossiping villagers gathered outside the shop to trade the morning's news.", "vibe": "Lively"},
    {"text": "Pink roses clambered over the doorway of the ancient, timbered inn.", "vibe": "Beautiful"},
    {"text": "Crooked, lichen-covered gravestones leaned at odd angles in the long grass, their names worn to whispers.", "vibe": "Menacing"},
    {"text": "The tall, slate-grey spire peeped over the rooftops.", "vibe": "General"},
    {"text": "The crumbling, abandoned farmhouse stood empty and silent at the end of the track.", "vibe": "Lonely"},
    {"text": "A rickety, wooden gate led to the churchyard.", "vibe": "General"},
    {"text": "Everyone they met smiled and waved as they passed.", "vibe": "Lively"},
    {"text": "Hens pecked in the dust outside the barn.", "vibe": "General"},
    {"text": "Somewhere a bell tolled in the darkness, though the church had been locked for years.", "vibe": "Menacing"},
    {"text": "The scent of cut grass drifted on the breeze.", "vibe": "Peaceful"},
    {"text": "Rolling, patchwork fields surrounded the village on every side.", "vibe": "Peaceful"},
    {"text": "It was a remote, forgotten hamlet: a dozen houses at the end of a road that led nowhere else.", "vibe": "Lonely"},
    {"text": "Not a single light showed in the empty, silent street.", "vibe": "Lonely"},
    {"text": "Rose-covered garden walls glowed pink in the last of the light.", "vibe": "Beautiful"},
    {"text": "The gale ripped the thatch from the roofs and flattened the corn in the fields.", "vibe": "Wild"},
    {"text": "Floodwater surged down the main street, carrying fences and hen coops with it.", "vibe": "Wild"},
    {"text": "On fête day the green was crowded with stalls, races and shrieking children.", "vibe": "Lively"},
    {"text": "Curtains twitched as the stranger walked by, but no door opened.", "vibe": "Menacing"},
    {"text": "In spring the orchard behind the church became a cloud of white blossom.", "vibe": "Beautiful"},
    {"text": "The village had one shop, one inn and one bus a day, and saw no reason to want more.", "vibe": "General"}
  ]
