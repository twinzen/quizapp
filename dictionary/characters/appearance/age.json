  "sentences": [
    {"text": "A chubby, rosy-cheeked toddler toddled across the lawn in pursuit of a pigeon.", "vibe": "Lively"},
    {"text": "The gangly, awkward adolescent had shot up over the summer and no longer knew where to put his arms.", "vibe": "General"},
    {"text": "Her smooth, unlined face glowed with youth.", "vibe": "Beautiful"},
    {"text": "A fine, delicate web of wrinkles fanned out from her eyes whenever she laughed.", "vibe": "General"},
    {"text": "A frail, stooped old man shuffled along the pavement, one careful step at a time.", "vibe": "Lonely"},
    {"text": "The spry, silver-haired grandmother moved with surprising speed when the kettle boiled.", "vibe": "Peaceful"},
    {"text": "A wizened, hawk-like face peered from the doorway.", "vibe": "Menacing"},
    {"text": "Deep, weathered creases furrowed his brow.", "vibe": "General"},
    {"text": "Thin, papery skin hung loosely on her arms.", "vibe": "Lonely"},
    {"text": "His gnarled, trembling hands shook as he lifted the cup.", "vibe": "Lonely"},
    {"text": "The grizzled, middle-aged sailor squinted at the horizon as if reading small print.", "vibe": "General"},
    {"text": "Her kind, careworn face softened into a smile.", "vibe": "Peaceful"},
    {"text": "She leaned heavily on her stick and waited for her breath to return.", "vibe": "General"},
    {"text": "His hair had greyed at the temples, which gave him an authority he had not earned.", "vibe": "General"},
    {"text": "He hobbled to the door, muttering about his knees.", "vibe": "Lonely"},
    {"text": "With boundless, youthful energy, she bounded up the stairs two at a time.", "vibe": "Lively"},
    {"text": "He had an ageless, serene face that might have been thirty or sixty.", "vibe": "Beautiful"},
