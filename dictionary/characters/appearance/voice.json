  "sentences": [
    {"text": "A deep, gravelly voice rumbled in his chest.", "vibe": "General"},
    {"text": "Her soft, soothing tone calmed the frightened child.", "vibe": "Peaceful"},
    {"text": "A cold, silky whisper slid into her ear.", "vibe": "Menacing"},
    {"text": "His loud, booming voice carried across the square.", "vibe": "Lively"},
    {"text": "Her thin, quavering voice trembled on every word.", "vibe": "Lonely"},
    {"text": "A harsh, rasping growl rose from the back of his throat.", "vibe": "Menacing"},
    {"text": "A rich, melodious voice filled the hall.", "vibe": "Beautiful"},
    {"text": "A high, squeaky giggle bubbled out of her.", "vibe": "Lively"},
    {"text": "His slow, lazy drawl stretched every vowel.", "vibe": "General"},
    {"text": "Her sharp, clipped tone cut him short.", "vibe": "Menacing"},
    {"text": "The flat, monotonous drone of the lecture sent half the class to sleep.", "vibe": "General"},
    {"text": "Her gentle, lilting accent rose and fell like a song.", "vibe": "Beautiful"},
    {"text": "His hoarse, broken croak cracked with emotion.", "vibe": "Lonely"},
    {"text": "Her voice dropped to a whisper.", "vibe": "General"},
    {"text": "His words trailed off into silence.", "vibe": "General"},
    {"text": "The sergeant bellowed across the yard.", "vibe": "Wild"},
    {"text": "He stammered an apology and backed out of the room.", "vibe": "General"},
    {"text": "The officer snapped an order, and the men moved.", "vibe": "Menacing"},
    {"text": "His whining, nasal voice grated on everyone's nerves.", "vibe": "General"},
    {"text": "\"Hush now,\" she murmured in her ear.", "vibe": "Peaceful"},
    {"text": "He roared until the veins stood out in his neck.", "vibe": "Wild"},
    {"text": "\"Enough!\" she thundered, and the room went still.", "vibe": "Wild"},
    {"text": "\"Sit down,\" he hissed, without moving his lips.", "vibe": "Menacing"},
    {"text": "Her voice faltered, and she could not finish the sentence.", "vibe": "Lonely"},
    {"text": "He had not spoken to anyone for days, and his own voice surprised him.", "vibe": "Lonely"},
    {"text": "The children's voices rose in a chorus of chuckles and shrieks.", "vibe": "Lively"},
    {"text": "When she sang, the pitch was true and the tone as clear as water.", "vibe": "Beautiful"},
    {"text": "His voice was low and unhurried, the kind that makes people lean in to listen.", "vibe": "Peaceful"},
    {"text": "He muttered something under his breath and gave a long sigh.", "vibe": "General"},
    {"text": "She cleared her throat and began again.", "vibe": "General"}
