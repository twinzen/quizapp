  "sentences": [
    {"text": "Her delicate, heart-shaped face tapered to a pointed chin.", "vibe": "Beautiful"},
    {"text": "Her smooth, flawless complexion glowed in the candlelight.", "vibe": "Beautiful"},
    {"text": "A long, jagged scar ran from his temple to his jaw.", "vibe": "Menacing"},
    {"text": "His sharp, angular features caught the lamplight and looked, for a moment, like something carved.", "vibe": "Menacing"},
    {"text": "Pale, waxen skin stretched tightly over his bones.", "vibe": "Lonely"},
    {"text": "A livid, purple bruise spread across her cheekbone.", "vibe": "Menacing"},
    {"text": "High, sculpted cheekbones cast faint shadows on her cheeks.", "vibe": "Beautiful"},
    {"text": "The fisherman's ruddy, weather-beaten cheeks reddened in the wind.", "vibe": "Lively"},
    {"text": "The fresh, raw graze stung in the cold air.", "vibe": "General"},
    {"text": "His square, determined jaw jutted forward.", "vibe": "General"},
    {"text": "His ashen, sweat-slicked face glistened under the lamp.", "vibe": "Menacing"},
    {"text": "A deep, ragged gash split his eyebrow.", "vibe": "Menacing"},
    {"text": "The prisoner's gaunt, sunken cheeks had hollowed with hunger until the skull showed through.", "vibe": "Lonely"},
    {"text": "A light, golden dusting of freckles scattered across her nose.", "vibe": "Lively"},
    {"text": "A thin, silvery line crossed the bridge of his nose.", "vibe": "General"},
    {"text": "The baker's round, dimpled face creased with laughter.", "vibe": "Lively"},
    {"text": "His tanned, leathery skin crinkled at the corners of his eyes.", "vibe": "General"},
    {"text": "His swollen, blackened eye had closed to a slit.", "vibe": "Menacing"},
    {"text": "His long, narrow face gave nothing away.", "vibe": "Menacing"},
    {"text": "A hot, crimson flush crept up her neck.", "vibe": "General"},
    {"text": "The old, faded scars on his face told their own story.", "vibe": "Lonely"},
    {"text": "Heavy, fleshy jowls wobbled as he spoke.", "vibe": "General"},
    {"text": "His blotchy, mottled skin darkened with anger.", "vibe": "Menacing"},
    {"text": "To everyone's surprise, the cut healed without a mark.", "vibe": "Peaceful"},
    {"text": "Her plump, placid face softened as she listened.", "vibe": "Peaceful"},
    {"text": "After a week of sea air, a soft, rosy bloom returned to her cheeks.", "vibe": "Peaceful"},
    {"text": "Raw, angry welts rose across his cheek where the branch had whipped him.", "vibe": "Wild"},
    {"text": "Rage twisted his face until his own mother would not have known him.", "vibe": "Wild"},
    {"text": "Her cheeks flamed, and her eyes flashed.", "vibe": "Wild"},
    {"text": "The boy wore his black eye like a medal.", "vibe": "Lively"}
