  "sentences": [
    {"text": "A loud, furious roar shook the windows.", "vibe": "Wild"},
    {"text": "A low, dangerous growl rumbled in his throat.", "vibe": "Menacing"},
    {"text": "Her cold, cutting tone sliced through the chatter.", "vibe": "Menacing"},
    {"text": "A sharp, impatient sigh hissed through her teeth.", "vibe": "General"},
    {"text": "His quiet, venomous whisper dripped with spite.", "vibe": "Menacing"},
    {"text": "The sergeant bellowed with rage.", "vibe": "Wild"},
    {"text": "\"Not now,\" she snapped without looking up.", "vibe": "General"},
    {"text": "He spat out the words as if they tasted bad.", "vibe": "Menacing"},
    {"text": "He muttered darkly about the weather, the train and the government.", "vibe": "General"},
    {"text": "After a long, bitter tirade, he exploded in a torrent of abuse.", "vibe": "Wild"},
    {"text": "A curt, clipped reply ended the conversation.", "vibe": "General"},
    {"text": "His thin, sneering laugh mocked her every word.", "vibe": "Menacing"},
    {"text": "Her shrill, piercing shriek rose to a scream.", "vibe": "Wild"},
    {"text": "He grumbled under his breath all the way up the stairs.", "vibe": "General"},
    {"text": "She tutted loudly and looked at her watch.", "vibe": "General"},
    {"text": "\"That's wrong,\" he interrupted rudely.", "vibe": "General"},
    {"text": "He lowered his voice to a hiss.", "vibe": "Menacing"},
    {"text": "With a gruff, exasperated bark, he demanded an answer.", "vibe": "General"},
    {"text": "By the end his was a hoarse, exhausted voice, with no anger left in it.", "vibe": "Lonely"},
    {"text": "\"Oh, well done,\" she said, in a harsh, sarcastic tone.", "vibe": "General"},
    {"text": "\"Get out!\" he roared, and the dog fled.", "vibe": "Wild"},
    {"text": "\"Never!\" she thundered.", "vibe": "Wild"},
    {"text": "\"You will regret this,\" he snarled.", "vibe": "Menacing"},
    {"text": "\"How clever of you,\" she sneered.", "vibe": "Menacing"},
    {"text": "His shouting echoed in the empty house, and nobody answered.", "vibe": "Lonely"},
    {"text": "The children shrieked at each other over whose turn it was.", "vibe": "Lively"},
    {"text": "\"I heard you the first time,\" he retorted.", "vibe": "General"},
    {"text": "There was an edge to her voice that had not been there before.", "vibe": "General"},
    {"text": "His voice dropped, and the threat went out of it.", "vibe": "Peaceful"},
    {"text": "\"Hurry up,\" she said for the fourth time.", "vibe": "General"}
  ]
