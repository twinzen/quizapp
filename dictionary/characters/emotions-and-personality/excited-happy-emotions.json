  "sentences": [
    {"text": "A sudden surge of joy swept through her.", "vibe": "Lively"},
    {"text": "Giddy, breathless excitement bubbled up inside him.", "vibe": "Lively"},
    {"text": "A deep, quiet contentment settled over her like a blanket.", "vibe": "Peaceful"},
