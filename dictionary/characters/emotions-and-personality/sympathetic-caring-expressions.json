  "sentences": [
    {"text": "A gentle, reassuring smile touched her lips.", "vibe": "Peaceful"},
    {"text": "Her kind, concerned look lingered on his face.", "vibe": "Peaceful"},
    {"text": "A small, sad smile trembled and faded.", "vibe": "Lonely"},
    {"text": "An anxious, worried frown creased his brow.", "vibe": "General"},
    {"text": "Her soft, tender gaze rested on the sleeping child.", "vibe": "Peaceful"},
    {"text": "He winced in sympathy as the plaster came off.", "vibe": "General"},
    {"text": "She nodded encouragingly from the front row.", "vibe": "Peaceful"},
    {"text": "Her eyes searched his face for some sign of what had happened.", "vibe": "General"},
    {"text": "Her face crumpled with pity.", "vibe": "Lonely"},
    {"text": "A warm, understanding expression softened her features.", "vibe": "Peaceful"},
    {"text": "A quick, sympathetic glance passed between them.", "vibe": "General"},
    {"text": "His thin, pitying smile did not reach his eyes.", "vibe": "Menacing"},
    {"text": "She tilted her head and waited for him to go on.", "vibe": "General"},
    {"text": "His forehead puckered with concern.", "vibe": "General"},
    {"text": "His grave, troubled face mirrored her own sadness.", "vibe": "Lonely"},
    {"text": "Her patient, motherly smile never faltered.", "vibe": "Peaceful"},
    {"text": "Her mouth drooped at the corners.", "vibe": "General"},
    {"text": "Her fierce, protective glare dared anyone to laugh.", "vibe": "Wild"},
    {"text": "A bright, encouraging grin flashed across the room.", "vibe": "Lively"},
    {"text": "She looked at him with pity, and it was worse than anger.", "vibe": "Menacing"},
    {"text": "He frowned so blackly at the bully that the boy stepped back.", "vibe": "Wild"},
    {"text": "She smiled at the little girl, but her own sadness showed through.", "vibe": "Lonely"},
    {"text": "The kindness in his face made her want to cry.", "vibe": "Lonely"},
    {"text": "Her whole expression melted, and for a moment she looked young again.", "vibe": "Beautiful"},
    {"text": "He smiled the kind of smile that says: take your time.", "vibe": "Peaceful"},
    {"text": "There was reassurance in her look and nothing hurried in it.", "vibe": "Peaceful"},
    {"text": "He glanced at her, frowned, and put down his pen.", "vibe": "General"},
    {"text": "Sympathy was written across his features as plainly as print.", "vibe": "General"},
    {"text": "The nurse gave him a wink and a thumbs-up.", "vibe": "Lively"},
    {"text": "She said nothing; her face had already said it.", "vibe": "Peaceful"}
  ]
