  "sentences": [
    {"text": "Her low, steady voice never wavered.", "vibe": "General"},
    {"text": "His firm, measured tone left no room for argument.", "vibe": "General"},
    {"text": "A cold, steely edge crept into his voice.", "vibe": "Menacing"},
    {"text": "She muttered under her breath as she worked through the sum.", "vibe": "General"},
    {"text": "He counted aloud, one stitch at a time.", "vibe": "General"},
    {"text": "Her slow, deliberate words dropped like stones into the silence.", "vibe": "General"},
    {"text": "Short, clipped commands cut through the noise.", "vibe": "Menacing"},
    {"text": "He repeated the instructions until he knew them by heart.", "vibe": "General"},
    {"text": "\"I will not let go,\" she vowed through gritted teeth.", "vibe": "Wild"},
    {"text": "Her calm, quiet certainty steadied the others.", "vibe": "Peaceful"},
    {"text": "A long, slow breath hissed between his teeth.", "vibe": "General"},
    {"text": "She lowered her voice and leaned closer.", "vibe": "General"},
    {"text": "A tight, strained grunt escaped his lips as the lid came loose.", "vibe": "General"},
    {"text": "A hushed, intense whisper carried no further than the desk.", "vibe": "Lonely"},
    {"text": "\"Again,\" she insisted quietly.", "vibe": "General"},
    {"text": "He paused before each word, choosing it with care.", "vibe": "General"},
    {"text": "She hummed tunelessly as she worked, a soft, absent murmur that she did not know she was making.", "vibe": "Peaceful"},
    {"text": "\"It can be done,\" he declared flatly.", "vibe": "General"},
    {"text": "In a flat, level voice, he read out the numbers.", "vibe": "General"},
    {"text": "A clear, confident voice called the next move.", "vibe": "Lively"},
    {"text": "\"Not yet,\" he snapped, without looking up.", "vibe": "Menacing"},
    {"text": "\"Hold the line,\" she ordered, and her tone was grim.", "vibe": "Menacing"},
    {"text": "\"Pull!\" he roared, and they pulled.", "vibe": "Wild"},
    {"text": "Her voice shook with effort, but the words kept coming.", "vibe": "Wild"},
    {"text": "He whispered the answer to himself, alone in the empty hall.", "vibe": "Lonely"},
    {"text": "\"Slowly,\" she murmured, \"slowly,\" and the thread went through.", "vibe": "Peaceful"},
    {"text": "He grunted, breathed, and tried the lock again.", "vibe": "General"},
    {"text": "There was a pause, a sigh, and then the scratch of the pen.", "vibe": "General"},
    {"text": "\"One more,\" she said, and it was not a question.", "vibe": "General"},
    {"text": "\"Ready,\" they answered together, and their voices were steady.", "vibe": "Lively"}
  ]
