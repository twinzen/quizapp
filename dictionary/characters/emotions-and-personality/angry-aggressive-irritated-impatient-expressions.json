  "sentences": [
    {"text": "A black, thunderous scowl darkened his face.", "vibe": "Menacing"},
    {"text": "His icy, withering glare froze the words on her lips.", "vibe": "Menacing"},
    {"text": "A thin, contemptuous sneer curled his lip.", "vibe": "Menacing"},
    {"text": "With a savage, wolfish snarl, he bared his teeth.", "vibe": "Wild"},
    {"text": "A sour, sullen expression settled on her face.", "vibe": "General"},
    {"text": "With a sulky, mutinous pout, the boy glowered from the corner.", "vibe": "General"},
    {"text": "A dark, murderous look flashed across his face.", "vibe": "Menacing"},
    {"text": "He ground his teeth and counted to ten.", "vibe": "General"},
    {"text": "She pressed her lips into a thin line.", "vibe": "General"},
    {"text": "His face twisted with rage.", "vibe": "Wild"},
    {"text": "He clenched his jaw until it ached.", "vibe": "General"},
    {"text": "A hard, hostile stare fixed on the stranger.", "vibe": "Menacing"},
    {"text": "Her tight-lipped, furious silence said more than words.", "vibe": "General"},
    {"text": "Her features contorted with fury.", "vibe": "Wild"},
    {"text": "He frowned impatiently at the clock.", "vibe": "General"},
    {"text": "His face became a cold, stony mask that hardened by the second.", "vibe": "Menacing"},
    {"text": "With a venomous, sidelong glance, she glared over her shoulder.", "vibe": "Menacing"},
    {"text": "The toddler's fierce, comical scowl made it hard not to laugh.", "vibe": "Lively"},
    {"text": "He snarled, and the veins stood out in his neck.", "vibe": "Wild"},
    {"text": "She looked ready to bite.", "vibe": "Wild"},
    {"text": "He scowled at the floor and sneered at the ceiling.", "vibe": "Menacing"},
    {"text": "There was contempt in every line of her face.", "vibe": "Menacing"},
    {"text": "He sat apart, wearing the shut face of someone nursing a grievance.", "vibe": "Lonely"},
    {"text": "Her mouth was bitter, as though she had tasted something sour years ago and never forgotten it.", "vibe": "Lonely"},
    {"text": "His jaw jutted, and his mouth tightened.", "vibe": "General"},
    {"text": "She pursed her lips, which had thinned almost to nothing.", "vibe": "General"},
    {"text": "A grimace of disgust crossed his face.", "vibe": "General"},
    {"text": "Her frown deepened with every word he said.", "vibe": "General"},
    {"text": "The twins pulled identical furious faces and then burst out laughing.", "vibe": "Lively"},
    {"text": "At last the scowl faded, and her face smoothed.", "vibe": "Peaceful"}
