  "sentences": [
    {"text": "A steep, narrow staircase climbed to the attic, each tread worn hollow in the middle.", "vibe": "General"},
    {"text": "She crept down the stairs in the dark, one hand on the cold, iron handrail.", "vibe": "Menacing"},
